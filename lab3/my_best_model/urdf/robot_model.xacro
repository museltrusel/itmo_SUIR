<?xml version='1.0'?>
<robot name="my_best_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find my_best_model)/urdf/materials.xacro" />
    <xacro:include filename="$(find my_best_model)/urdf/wheel.xacro" />
    <xacro:include filename="$(find my_best_model)/urdf/inertial.xacro" />

    <!-- Вариант 9 — 9 звеньев, шарниры RPRC CC, база 220x160x90 мм -->

    <!-- Мобильная база -->
    <xacro:property name="base_length" value="0.22"/>
    <xacro:property name="base_width" value="0.16"/>
    <xacro:property name="base_height" value="0.09"/>
    <xacro:property name="base_z" value="0.065"/>
    <xacro:property name="wheel_radius" value="0.04"/>
    <xacro:property name="wheel_length" value="0.02"/>
    <xacro:property name="caster_radius" value="0.02"/>

    <!-- Манипулятор -->
    <xacro:property name="mount_radius" value="0.03"/>
    <xacro:property name="mount_height" value="0.02"/>
    <xacro:property name="link1_radius" value="0.025"/>
    <xacro:property name="link1_length" value="0.05"/>
    <xacro:property name="link2_size" value="0.025"/>
    <xacro:property name="link2_length" value="0.08"/>
    <xacro:property name="link2_stroke" value="0.06"/>
    <xacro:property name="link3_size" value="0.02"/>
    <xacro:property name="link3_length" value="0.10"/>
    <xacro:property name="link4_radius" value="0.012"/>
    <xacro:property name="link4_length" value="0.03"/>

    <!-- 1. base_link — корпус и опорный шар -->
    <link name='base_link'>
        <visual name='base_visual'>
            <origin xyz="0.0 0.0 ${base_z}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <xacro:inertial_box mass="1" x="${base_length}" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
        </xacro:inertial_box>
        <collision>
            <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <collision name='caster_collision'>
            <origin xyz="-0.08 0 ${caster_radius}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0</mu>
                        <mu2>0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <visual name='caster_visual'>
            <origin xyz="-0.08 0.0 ${caster_radius}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <!-- 2, 3. Колёса — шарниры C C -->
    <xacro:wheel side="left" x="0.05" y="${base_width/2 + wheel_length/2 + 0.005}" z="${wheel_radius}"
                 radius="${wheel_radius}" length="${wheel_length}"/>
    <xacro:wheel side="right" x="0.05" y="${-(base_width/2 + wheel_length/2 + 0.005)}" z="${wheel_radius}"
                 radius="${wheel_radius}" length="${wheel_length}"/>

    <!-- 4. Основание манипулятора, жёстко закреплено на крыше базы -->
    <link name='arm_base_link'>
        <visual name='arm_base_visual'>
            <origin xyz="0 0 ${mount_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${mount_radius}" length="${mount_height}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <xacro:inertial_cylinder mass="0.1" length="${mount_height}" radius="${mount_radius}">
            <origin xyz="0 0 ${mount_height/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        <collision>
            <origin xyz="0 0 ${mount_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${mount_radius}" length="${mount_height}"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_base_joint" type="fixed">
        <origin xyz="0.03 0 ${base_z + base_height/2}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="arm_base_link"/>
    </joint>

    <!-- 5. Звено 1, шарнир R — поворот вокруг вертикали -->
    <link name='arm_link1'>
        <visual name='arm_link1_visual'>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <xacro:inertial_cylinder mass="0.1" length="${link1_length}" radius="${link1_radius}">
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        <collision>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_joint1" type="revolute">
        <origin xyz="0 0 ${mount_height}" rpy="0 0 0"/>
        <parent link="arm_base_link"/>
        <child link="arm_link1"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-pi}" upper="${pi}" effort="10" velocity="1.0"/>
    </joint>

    <!-- 6. Звено 2, шарнир P — телескопический подъём вверх, нижняя часть уходит внутрь звена 1 -->
    <link name='arm_link2'>
        <visual name='arm_link2_visual'>
            <origin xyz="0 0 ${(link2_length - link2_stroke)/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${link2_size} ${link2_size} ${link2_length + link2_stroke}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <xacro:inertial_box mass="0.08" x="${link2_size}" y="${link2_size}" z="${link2_length}">
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
        <collision>
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${link2_size} ${link2_size} ${link2_length}"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_joint2" type="prismatic">
        <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
        <parent link="arm_link1"/>
        <child link="arm_link2"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="${link2_stroke}" effort="10" velocity="0.1"/>
    </joint>

    <!-- 7. Звено 3, шарнир R — наклон вверх-вниз -->
    <link name='arm_link3'>
        <visual name='arm_link3_visual'>
            <origin xyz="${link3_length/2} 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${link3_length} ${link3_size} ${link3_size}"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <xacro:inertial_box mass="0.05" x="${link3_length}" y="${link3_size}" z="${link3_size}">
            <origin xyz="${link3_length/2} 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
        <collision>
            <origin xyz="${link3_length/2} 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${link3_length} ${link3_size} ${link3_size}"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_joint3" type="revolute">
        <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
        <parent link="arm_link2"/>
        <child link="arm_link3"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1.0"/>
    </joint>

    <!-- 8. Звено 4, шарнир C — вращение кисти без ограничений -->
    <link name='arm_link4'>
        <visual name='arm_link4_visual'>
            <origin xyz="${link4_length/2} 0 0" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="${link4_radius}" length="${link4_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <xacro:inertial_cylinder mass="0.02" length="${link4_length}" radius="${link4_radius}">
            <origin xyz="${link4_length/2} 0 0" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_cylinder>
        <collision>
            <origin xyz="${link4_length/2} 0 0" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="${link4_radius}" length="${link4_length}"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_joint4" type="continuous">
        <origin xyz="${link3_length} 0 0" rpy="0 0 0"/>
        <parent link="arm_link3"/>
        <child link="arm_link4"/>
        <axis xyz="1 0 0"/>
        <limit effort="10" velocity="2.0"/>
    </joint>

    <!-- 9. Схват, жёстко закреплён на конце кисти -->
    <link name='gripper_link'>
        <visual name='gripper_visual'>
            <origin xyz="0.005 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.01 0.05 0.015"/>
            </geometry>
            <material name="red"/>
        </visual>
        <xacro:inertial_box mass="0.01" x="0.01" y="0.05" z="0.015">
            <origin xyz="0.005 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
        <collision>
            <origin xyz="0.005 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.01 0.05 0.015"/>
            </geometry>
        </collision>
    </link>
    <joint name="gripper_joint" type="fixed">
        <origin xyz="${link4_length} 0 0" rpy="0 0 0"/>
        <parent link="arm_link4"/>
        <child link="gripper_link"/>
    </joint>

</robot>
